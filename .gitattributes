* text=auto

# Runtime scripts must retain LF line endings. Executable modes are also
# normalised by build-usb.sh because some filesystems and Git clients lose them.
*.sh text eol=lf
archctl text eol=lf
build-usb.sh text eol=lf
install.sh text eol=lf
start.sh text eol=lf
upgrade-existing.sh text eol=lf
usb/API_VERSION text eol=lf

*.conf text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
