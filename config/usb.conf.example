# Copy this file to MASON-ARCH/config/usb.conf on the installer USB.
# It is sourced by Bash. Do not store passwords or personal access tokens here.

# Use a public HTTPS GitHub URL. Do not embed a token: this file is on a FAT
# filesystem and is not a secret store. Leave blank to use only the repository
# snapshot stored on the USB.
REPO_URL=""
REPO_REF="main"
# Optional exact full commit hash. When set, a downloaded repository must
# resolve to it; moving-branch behaviour is disabled until this hash changes.
REPO_PINNED_COMMIT=""

# Normally the machine profile follows GitHub/current cached repository state.
# The local USB profile remains an emergency fallback. Set to local when the
# USB's config/install.conf should always win.
INSTALL_CONFIG_SOURCE="repository"
INSTALL_CONFIG_REPO_PATH="profiles/t480.conf"

# Policies: always, prompt, or never.
REPO_UPDATE_POLICY="always"
ARCH_UPDATE_POLICY="always"
PACKAGE_CACHE_UPDATE_POLICY="prompt"
AUR_CACHE_UPDATE_POLICY="prompt"

ARCH_MIRROR="https://geo.mirror.pkgbuild.com"
NETWORK_CHECK_URL="https://archlinux.org/"

# The extracted A/B slots are already independent bootable backups. Retaining
# the downloaded ISO consumes additional space and is normally unnecessary.
KEEP_DOWNLOADED_ISO=false

# A cache refresh stages a complete new generation before replacing the old
# one, so it needs free room for both.
PACKAGE_CACHE_MIN_FREE_MIB=8192

# On failed connectivity, offer the Arch ISO's interactive Wi-Fi tool.
OFFER_WIFI_SETUP=true
