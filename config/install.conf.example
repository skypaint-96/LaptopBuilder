# Copy this file to config/install.conf and review every setting.
# This file is sourced by Bash; use normal shell assignment syntax.
# Do not commit passwords or private keys.

# DESTRUCTIVE target. Confirm with: lsblk -o NAME,SIZE,MODEL,SERIAL,TYPE,MOUNTPOINTS
DISK="/dev/nvme0n1"
ESP_SIZE_MIB=1024

HOSTNAME="arch-t480"
USERNAME="mason"
TIMEZONE="Europe/London"
LOCALE="en_GB.UTF-8"
KEYMAP="uk"
X11_LAYOUT="gb"

# Explicit hardware profiles keep the build reproducible. Supported GPU profiles: intel, amd, generic.
CPU_VENDOR="intel"
GPU_VENDOR="intel"

# The normal kernel plus LTS provides a second bootable UKI.
KERNELS="linux linux-lts"
FILESYSTEM="btrfs"
DESKTOP="xfce"

ENABLE_MULTILIB=true
# Periodic TRIM through dm-crypt improves SSD maintenance but exposes which blocks are unused.
ENABLE_SSD_TRIM=true
ENABLE_AUR=true
AUR_HELPER="paru"
# Build Paru from source against the installed pacman/libalpm ABI. The bootstrap
# installs the explicit rust provider first, so no Cargo-provider prompt appears.
AUR_HELPER_PACKAGE="paru"
AUR_PACKAGES="microsoft-edge-stable-bin visual-studio-code-bin powershell-bin onedrive-abraunegg"
# Automated mode trusts only the explicit allow-list above and skips routine
# PKGBUILD/rebuild prompts. Set false when you want to review every AUR build.
AUR_NONINTERACTIVE=true
# Suppress routine pacman confirmations during the reproducible first-boot run.
PROVISION_NONINTERACTIVE=true

ENABLE_DOCKER=true
# Membership of the docker group is convenient but effectively root-equivalent.
DOCKER_ADD_USER_TO_GROUP=true
ENABLE_GAMING=true
ENABLE_SNAPSHOTS=true
ENABLE_T480=true
ENABLE_POWERSHELL_PROFILE=true
INSTALL_POWERSHELL_MODULES=false
INSTALL_VSCODE_EXTENSIONS=true
ENABLE_BLUETOOTH=true
# Install and enable the OpenSSH server by default. Review sshd_config before exposing it beyond a trusted network.
ENABLE_SSH=true

# Manage Xfce preferred applications and common XDG MIME associations.
# The current supported application set is intentionally explicit and validated.
MANAGE_DEFAULT_APPLICATIONS=true
DEFAULT_BROWSER="edge"
DEFAULT_MAIL_HANDLER="edge"
DEFAULT_FILE_MANAGER="thunar"
DEFAULT_TERMINAL="xfce4-terminal"
DEFAULT_TEXT_EDITOR="mousepad"
DEFAULT_CODE_EDITOR="vscode"
DEFAULT_IMAGE_VIEWER="ristretto"
DEFAULT_ARCHIVE_MANAGER="file-roller"
DEFAULT_MEDIA_PLAYER="mpv"
DEFAULT_PDF_VIEWER="edge"

# Cloud sync and first-login authentication. Tokens remain in each application's
# normal per-user credential store and are never copied into Git or the USB.
ENABLE_ONEDRIVE=true
# Relative to the configured user's home directory.
ONEDRIVE_SYNC_DIR="OneDrive"
# These home folders are linked to matching directories under ONEDRIVE_SYNC_DIR
# only after OneDrive authentication and a successful initial synchronisation.
ONEDRIVE_LINK_DIRS="Documents Pictures Videos"
ONEDRIVE_SKIP_DOTFILES=true
ONEDRIVE_SKIP_SYMLINKS=true
ONEDRIVE_USE_RECYCLE_BIN=true
ONEDRIVE_ENABLE_SERVICE=true
# Keep the interactive OAuth step in the foreground, then queue the potentially
# long dry-run, initial sync, folder migration, and service enablement in systemd.
ONEDRIVE_INITIAL_SYNC_BACKGROUND=true
ONEDRIVE_NOTIFY_ON_COMPLETION=true

# Start a one-time wizard after the first graphical login. The wizard checks each
# provider first and only asks for authentication when no valid session is found.
ENABLE_FIRST_LOGIN_AUTH=true
AUTH_GITHUB_CLI=true
GITHUB_GIT_PROTOCOL="https"
AUTH_ONEDRIVE=true
AUTH_VSCODE=true
AUTH_EDGE=true
AUTH_STEAM=true
# Open Edge first and wait for its welcome/privacy screens to be completed before
# GitHub or Microsoft OAuth is allowed to launch the default browser.
EDGE_PREPARE_BEFORE_OAUTH=true

ENABLE_SECURE_BOOT=true
# Requiring Setup Mode before disk changes lets the installer enrol owner keys
# and sign the complete boot chain automatically, before the first reboot.
REQUIRE_SETUP_MODE_AT_INSTALL=true
AUTO_PREPARE_SECURE_BOOT=true
# Retaining Microsoft UEFI certificates is the compatibility-oriented default.
SBCTL_ENROLL_MICROSOFT=true
ENABLE_TPM=true
REQUIRE_TPM=true
# PCR 7 measures the Secure Boot policy and remains practical across kernel updates.
TPM_PCRS="7"
TPM_WITH_PIN=true
# Six digits is the default minimum for a daily TPM PIN.
TPM_PIN_MIN_LENGTH=6
TPM_PIN_NUMERIC_ONLY=true
# When credentials are supplied by the USB, retain the LUKS passphrase and TPM PIN
# temporarily inside the encrypted target root until first-boot TPM enrollment succeeds.
STAGE_TPM_CREDENTIALS=true

# Optional battery thresholds. Disabled by default because they are personal policy.
T480_BATTERY_THRESHOLDS=false
T480_START_CHARGE=40
T480_STOP_CHARGE=80

# Secrets are prompted securely by default. As an alternative, point to root-readable
# files whose permissions are 0400 or 0600. Only the first line is read.
LUKS_PASSPHRASE_FILE=""
USER_PASSWORD_FILE=""
TPM_PIN_FILE=""
# Written automatically into the installed runtime configuration by the live launcher.
INITIAL_INSTALL_SOURCE_MODE="live"

# Safety controls. Keep NONINTERACTIVE=false for normal use.
NONINTERACTIVE=false
# In non-interactive mode this must exactly equal: ERASE /dev/your-disk
WIPE_CONFIRMATION=""
ALLOW_NON_ARCHISO=false
