# This file is documentation only. Do not source a file containing literal secrets.
# Prefer separate files with mode 0600, referenced from install.conf:
#
# LUKS_PASSPHRASE_FILE="/root/arch-secrets/luks-passphrase"
# USER_PASSWORD_FILE="/root/arch-secrets/user-password"
#
# Create them without putting the value into shell history:
#
# install -d -m 0700 /root/arch-secrets
# read -r -s -p "LUKS passphrase: " secret; echo
# printf '%s\n' "$secret" > /root/arch-secrets/luks-passphrase
# unset secret
# chmod 0600 /root/arch-secrets/luks-passphrase
