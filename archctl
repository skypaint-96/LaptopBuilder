#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
CONFIG_FILE="${ARCH_WORKSTATION_CONFIG:-/etc/arch-installer/install.conf}"

if [[ ! -r $CONFIG_FILE && -r $REPO_ROOT/config/install.conf ]]; then
  CONFIG_FILE="$REPO_ROOT/config/install.conf"
fi

usage() {
  cat <<'EOF'
Usage: archctl [--config PATH] COMMAND [arguments]

Commands:
  finish                Resume the complete first-boot workflow (recommended)
  status                Show the current first-boot/security stage
  provision             Apply Ansible roles and user-level configuration
  secure-boot           Enrol owner keys and sign every EFI binary
  tpm-enroll            Enrol TPM2 unlock after Secure Boot is active
  tpm-remove            Remove TPM2 unlock and keep passphrase boot
  recovery-key          Add a high-entropy LUKS recovery key
  verify                Run the strict final installation/security audit
  snapshot [TEXT]       Create a manual Snapper root snapshot
  update                Update official/AUR packages and signed boot assets
  help                  Show this help

Commands that need root privilege elevate themselves. Run finish/provision as the
configured normal user, not through sudo.
EOF
}

while (($#)); do
  case "$1" in
    --config)
      [[ $# -ge 2 ]] || { echo "--config requires a path" >&2; exit 2; }
      CONFIG_FILE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

COMMAND=${1:-help}
if (($#)); then shift; fi
export ARCH_WORKSTATION_CONFIG="$CONFIG_FILE"
export ARCH_WORKSTATION_ROOT="$REPO_ROOT"

root_exec() {
  local script=$1
  shift
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    exec "$script" "$@"
  fi
  exec sudo env \
    "ARCH_WORKSTATION_CONFIG=$CONFIG_FILE" \
    "ARCH_WORKSTATION_ROOT=$REPO_ROOT" \
    "$script" "$@"
}

user_exec() {
  local script=$1
  shift

  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    exec "$script" "$@"
  fi

  # A common mistake is `sudo archctl finish`. Preserve the already-open sudo
  # timestamp but run user-level package/configuration work as the caller.
  if [[ -n ${SUDO_USER:-} && $SUDO_USER != root ]]; then
    exec sudo -u "$SUDO_USER" -H env \
      "ARCH_WORKSTATION_CONFIG=$CONFIG_FILE" \
      "ARCH_WORKSTATION_ROOT=$REPO_ROOT" \
      "$script" "$@"
  fi

  echo "Run '$COMMAND' as the configured normal user, not from a root shell." >&2
  exit 1
}

case "$COMMAND" in
  finish|first-boot)
    user_exec "$REPO_ROOT/scripts/finish.sh" "$@"
    ;;
  status|doctor)
    root_exec "$REPO_ROOT/scripts/security/status.sh" "$@"
    ;;
  provision)
    user_exec "$REPO_ROOT/scripts/provision.sh" "$@"
    ;;
  secure-boot)
    root_exec "$REPO_ROOT/scripts/security/secure-boot.sh" "$@"
    ;;
  tpm-enroll)
    root_exec "$REPO_ROOT/scripts/security/tpm-enroll.sh" "$@"
    ;;
  tpm-remove)
    root_exec "$REPO_ROOT/scripts/security/tpm-remove.sh" "$@"
    ;;
  recovery-key)
    root_exec "$REPO_ROOT/scripts/security/recovery-key.sh" "$@"
    ;;
  verify)
    root_exec "$REPO_ROOT/scripts/security/verify.sh" "$@"
    ;;
  snapshot)
    description=${*:-"Manual snapshot"}
    if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
      exec snapper -c root create --description "$description" --cleanup-algorithm number --print-number
    fi
    exec sudo snapper -c root create --description "$description" --cleanup-algorithm number --print-number
    ;;
  update)
    user_exec "$REPO_ROOT/scripts/update.sh" "$@"
    ;;
  help)
    usage
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
